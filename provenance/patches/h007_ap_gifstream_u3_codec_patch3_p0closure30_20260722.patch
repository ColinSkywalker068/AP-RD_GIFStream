+def _write_total_candidate_failure(
+    args: argparse.Namespace,
+    manifest: Mapping[str, Any],
+    reference_sha: str,
+    manifest_sha: str,
+    freeze_sha: str,
+    provenance_fields: Mapping[str, Any],
+    reference_payload: bytes,
+    error: Exception,
