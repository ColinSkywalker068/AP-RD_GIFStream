+class _FixtureStoragePickler(pickle.Pickler):
+    def persistent_id(self, value):
+        if isinstance(value, _FixtureStorage):
+            return (
+                "storage",
+                _FixtureFloatStorage,
+                str(value.key),
+                "cuda:0",
+                value.numel,
+            )
+        return None
