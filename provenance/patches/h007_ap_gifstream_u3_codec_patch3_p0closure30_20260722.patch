+def alpha_parent_contributions(
+    splats: Mapping[str, Tensor],
+    decoders: torch.nn.ModuleDict,
+    app_module: Optional[CountedCameraEmbedding],
+    config: Mapping[str, Any],
+    camtoworlds: Tensor,
+    intrinsics: Tensor,
