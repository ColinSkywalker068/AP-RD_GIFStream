+            "gops": [
+                {
+                    "bytes": len(inner_payload),
+                    "sha256": hashlib.sha256(inner_payload).hexdigest(),
+                    "decoder_config_sha256": hashlib.sha256(decoder_payload).hexdigest(),
+                }
+            ],
+        }
+        return sequence, inner_payload, validation
