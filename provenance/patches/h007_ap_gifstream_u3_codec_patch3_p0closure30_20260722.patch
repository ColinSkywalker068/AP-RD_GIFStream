+        "gop_id": int(manifest["gop_id"]),
+        "gop_start_frame": int(manifest["gop_start_frame"]),
+        "camera": "cam00",
+        "camera_key": None,
+        "method": args.method,
+        "reference_artifact_sha256": reference_sha,
+        "reference_manifest_sha256": manifest_sha,
