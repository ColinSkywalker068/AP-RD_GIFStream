+    _validate_render_splats(splats, config)
+    neighbors = knn_indices if knn_indices is not None else counted_knn_indices(splats, config)
+    with torch.no_grad():
+        _, _, child_audit, children = _render_once(
+            splats,
+            decoders,
+            app_module,
+            config,
+            camtoworlds,
+            intrinsics,
