+def _contiguous_stride(shape: Tuple[int, ...]) -> Tuple[int, ...]:
+    stride: List[int] = []
+    running = 1
+    for size in reversed(shape):
+        stride.append(running)
+        running *= size
+    return tuple(reversed(stride))
