+        if ranking == "path":
+            scores = path_score.clone()
+        elif ranking == "motion":
+            scores = motion_score.clone()
+        elif ranking == "random":
+            generator = torch.Generator(device="cpu")
+            generator.manual_seed(int(self.cfg.ap_random_seed))
