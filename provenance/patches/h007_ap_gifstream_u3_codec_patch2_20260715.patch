+def build_equal_estimated_byte_allocation(
+    official_active: Tensor,
+    scores: Tensor,
+    eligible: Tensor,
+    canonical_ids: Tensor,
+    estimated_bytes: Tensor,
+    protected_fraction: float,
+    enable_swap: bool,
+    starting_active: Optional[Tensor] = None,
+    retain_mask: Optional[Tensor] = None,
